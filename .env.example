# Copy to .env and fill in. NEVER commit .env.
#
# Phase 1 runs entirely against a LOCAL OpenAI-compatible endpoint (SGLang).
# No proprietary LLM provider key is required or permitted.

# Path to the pinned upstream Biomni checkout (see external/BIOMNI_PIN.json)
BIOMNI_SRC=/path/to/Biomni

# Biomni data root (data lake + benchmark downloads land under $BIOMNI_PATH/biomni_data)
BIOMNI_PATH=/path/to/scratch/biomni_data_root

# Hugging Face cache (model weights + Eval1 parquet)
HF_HOME=/path/to/scratch/hf_cache

# Local model endpoint API key placeholder required by the OpenAI client. Not a secret.
BIOMNI_CUSTOM_API_KEY=EMPTY

# Optional: HF token for higher download rate limits (a real secret - do not commit)
# HF_TOKEN=
